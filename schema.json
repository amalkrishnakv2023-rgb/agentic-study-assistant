{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Study Assistant Data Schema",
  "description": "JSON schema for the Agentic Study Assistant structured execution output, study plan, tool trace, and task storage.",
  "type": "object",
  "required": [
    "goal",
    "plan",
    "tool_trace"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "description": "Natural-language request or goal entered by the student."
    },
    "message": {
      "type": "string",
      "description": "Human-readable response message generated by the agent."
    },
    "plan": {
      "type": "array",
      "description": "Scheduled study tasks fitting within the student's available time.",
      "items": {
        "type": "object",
        "required": [
          "task",
          "minutes",
          "priority"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Title of the scheduled task."
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Duration allocated to the task in minutes (must be > 0)."
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Task priority level."
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Optional ISO 8601 deadline (YYYY-MM-DD)."
          }
        },
        "additionalProperties": false
      }
    },
    "tool_trace": {
      "type": "array",
      "description": "Observable agent actions and tool outputs for the executed request.",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "observation"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "description": "Name of the executed tool."
          },
          "observation": {
            "type": "string",
            "description": "Observation output returned by the tool."
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "description": "List of all stored tasks in local JSON persistence.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "minutes",
          "priority",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Task title."
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Task duration in minutes (must be > 0)."
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Task priority level."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done"
            ],
            "description": "Completion status."
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Optional deadline formatted as YYYY-MM-DD or null."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
